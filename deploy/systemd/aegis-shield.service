[Unit]
Description=Aegis Shield — ransomware isolation daemon
Documentation=https://github.com/kingryankingofkings-bit/phovidsya/blob/main/docs/DEPLOYMENT.md
After=network.target
Wants=network-online.target

[Service]
Type=exec
User=aegis
Group=aegis
WorkingDirectory=/var/lib/aegis-shield

# Stable API key, root-owned and group-readable by aegis. Without this the
# daemon mints an ephemeral key on every restart, breaking all clients.
EnvironmentFile=/etc/aegis-shield/env

ExecStart=/usr/local/bin/aegis-shield start /var/lib/aegis-shield/namespace \
    --host 127.0.0.1 \
    --port 8443 \
    --public-key /etc/aegis-shield/admin.pub

ExecStop=/bin/kill -TERM $MAINPID
TimeoutStopSec=30

Restart=on-failure
RestartSec=5s

ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/aegis-shield /run/aegis-shield
RuntimeDirectory=aegis-shield
PrivateTmp=true
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
